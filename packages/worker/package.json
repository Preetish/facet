{
  "name": "@facet/worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker zero-flicker edge personalization reverse proxy for Facet",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Preetish/facet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Preetish/facet.git",
    "directory": "packages/worker"
  },
  "bugs": {
    "url": "https://github.com/Preetish/facet/issues"
  },
  "keywords": [
    "facet",
    "cloudflare-workers",
    "htmlrewriter",
    "personalization",
    "edge",
    "abm",
    "message-match",
    "reverse-proxy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@facet/core": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250426.0",
    "html-rewriter-wasm": "^0.4.1"
  }
}
