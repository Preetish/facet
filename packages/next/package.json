{
  "name": "@facet/next",
  "version": "0.1.0",
  "description": "Hydration-safe Next.js Middleware and Server Component helpers for Facet",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Preetish/facet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Preetish/facet.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/Preetish/facet/issues"
  },
  "keywords": [
    "facet",
    "nextjs",
    "react",
    "server-components",
    "middleware",
    "personalization",
    "abm",
    "message-match"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@facet/core": "0.1.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
