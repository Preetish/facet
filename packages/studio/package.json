{
  "name": "@facet/studio",
  "version": "0.1.0",
  "description": "Self-hosted marketer admin UI and Web Standard API server for Facet",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Preetish/facet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Preetish/facet.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/Preetish/facet/issues"
  },
  "keywords": [
    "facet",
    "studio",
    "personalization",
    "abm",
    "message-match",
    "admin-ui",
    "cloudflare-workers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "facet-studio": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "build": "npm run build:server && npm run build:ui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@facet/core": "0.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  }
}
