{
  "name": "@facet/core",
  "version": "0.1.0",
  "description": "Pure zero-I/O edge website personalization and ad message-match engine for Facet",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Preetish/facet#readme",
  "repository": {
